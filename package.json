{
  "name": "@weavetab/sdk",
  "version": "2.5.0",
  "description": "Official TypeScript SDK for developing Weavetab plugins and tools.",
  "author": {
    "name": "fy2ne",
    "email": "hello@fy2ne.me",
    "url": "https://fy2ne.me"
  },
  "license": "MIT",
  "homepage": "https://github.com/weavetab/sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/weavetab/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/weavetab/sdk/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/exporter.js",
      "types": "./dist/schema/exporter.d.ts"
    },
    "./schema/plugin.json": "./schema/plugin.json",
    "./schema/tool.json": "./schema/tool.json"
  },
  "bin": {
    "weavetab": "dist/cli.js",
    "weavetab-sdk": "dist/cli.js",
    "weavetab-plugin": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.mjs",
    "sync:schema": "node scripts/sync-schema.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "weavetab",
    "weavetab-sdk",
    "weavetab-plugin",
    "mcp",
    "mcp-plugin",
    "browser-automation"
  ],
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.0.0"
  }
}
